{
  "name": "faidatech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:seed:billing": "node scripts/seed-billing.mjs",
    "db:migrate": "node scripts/prisma-with-tls.mjs migrate dev",
    "db:deploy": "node scripts/prisma-with-tls.mjs migrate deploy",
    "db:status": "node scripts/prisma-with-tls.mjs migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "6.2.15",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "22.19.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
