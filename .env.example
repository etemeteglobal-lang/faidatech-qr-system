# FaidATech uses PostgreSQL through Prisma. The managed Webdev database is MySQL-compatible;
# use an external PostgreSQL DSN for POSTGRES_URL.
# Use the Supabase Shared Pooler Session URL when direct IPv6 is unavailable. The app and
# Prisma migration scripts enforce TLS by setting sslmode=require.
POSTGRES_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/DATABASE?schema=public&sslmode=require"

# Public origin used for scannable QR destinations. OAuth callbacks use the current app origin.
APP_BASE_URL="https://faidatech.example"

# Browser-safe Supabase project values; never use or expose a service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Optional dedicated key for pseudonymous IP hashing. If omitted, no IP hash is stored.
# Raw IP addresses are never persisted.
SCAN_IP_HASH_SECRET="replace-with-a-long-random-secret"

# Optional billing provider integration. Checkout remains disabled until all three are configured.
BILLING_PROVIDER_BASE_URL="https://billing-provider.example/api"
BILLING_PROVIDER_SECRET="replace-with-a-protected-provider-secret"
BILLING_WEBHOOK_SECRET="replace-with-a-protected-webhook-signing-secret"

# Optional Sentry observability. No custom auth domain is required.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENABLED="false"
SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_TRACES_SAMPLE_RATE="0.1"

PORT=3000
