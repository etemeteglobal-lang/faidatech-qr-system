# FaidATech uses PostgreSQL through Prisma. The managed Webdev database is MySQL-compatible;
# use an external PostgreSQL DSN. POSTGRES_URL is preferred; DATABASE_URL is accepted as
# a deployment-platform alias. Use the Supabase pooler on port 6543 with pgbouncer=true
# for runtime traffic and keep the direct port 5432 URL for later migrations.
POSTGRES_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?schema=public&pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?schema=public&pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public&sslmode=require"

# Public origin used for scannable QR destinations. OAuth callbacks use the current app origin.
APP_BASE_URL="https://faidatech.example"

# Browser-safe Supabase project values; never use or expose a service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Optional dedicated key for pseudonymous IP hashing. If omitted, no IP hash is stored.
# Raw IP addresses are never persisted.
SCAN_IP_HASH_SECRET="replace-with-a-long-random-secret"

# Optional billing provider integration. Unconfigured providers remain pending and never
# activate subscriptions. Configure only the three supported payment tracks.
TELEBIRR_API_BASE_URL="https://telebirr.example/api"
TELEBIRR_SECRET_KEY="replace-with-a-protected-telebirr-secret"
TELEBIRR_WEBHOOK_SECRET="replace-with-a-protected-telebirr-webhook-secret"
CHAPA_API_BASE_URL="https://chapa.example/api"
CHAPA_SECRET_KEY="replace-with-a-protected-chapa-secret"
CHAPA_WEBHOOK_SECRET="replace-with-a-protected-chapa-webhook-secret"
STRIPE_API_BASE_URL="https://api.stripe.com/v1"
STRIPE_SECRET_KEY="replace-with-a-protected-stripe-secret"
STRIPE_WEBHOOK_SECRET="replace-with-a-protected-stripe-webhook-secret"

# Optional Sentry observability. No custom auth domain is required.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENABLED="false"
SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_TRACES_SAMPLE_RATE="0.1"

PORT=3000
